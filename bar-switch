#!/usr/bin/env bash
# bar-switch — toggle or switch between waybar and quickshell.
#
# Usage:
#   bar-switch            # toggle (whichever is running -> the other)
#   bar-switch quickshell # stop waybar, start quickshell
#   bar-switch waybar     # stop quickshell, start waybar
#
# Quickshell uses its default config at ~/.config/quickshell/shell.qml.
# To remove the whole quickshell experiment later:
#   rm -rf ~/.config/quickshell
# (waybar is still launched by Hyprland autostart, so a reboot returns to it.)

set -u

qs_running() { pgrep -x quickshell >/dev/null 2>&1; }
wb_running() { pgrep -x waybar    >/dev/null 2>&1; }

start_qs() { qs_running || quickshell >/dev/null 2>&1 & }
start_wb() { wb_running || waybar    >/dev/null 2>&1 & }
stop_qs()  { pkill -x quickshell 2>/dev/null; }
stop_wb()  { pkill -x waybar    2>/dev/null; }

case "${1:-toggle}" in
  quickshell|qs) stop_wb; start_qs ;;
  waybar|wb)     stop_qs; start_wb ;;
  toggle|*)      if qs_running; then stop_qs; start_wb; else stop_wb; start_qs; fi ;;
esac
