# Rendered by scripts/render-theme.sh from the active theme palette.
# Do not edit: the next palette load overwrites this file.
#
# btop lists user themes from ~/.config/btop/themes/. Pick `theme` once in
# btop's options menu (Esc -> Color theme); see docs/user/theme-desktop-setup.md.

# Main background. Empty would mean the terminal background; a theme supplies
# one, so btop paints its own.
theme[main_bg]="{{background}}"

# Main text color
theme[main_fg]="{{foreground}}"

# Title color for boxes
theme[title]="{{accent}}"

# Highlight color for keyboard shortcuts
theme[hi_fg]="{{accent}}"

# Background color of the selected process
theme[selected_bg]="{{selection}}"

# Text color of the selected process
theme[selected_fg]="{{foreground}}"

# Color of inactive/disabled text
theme[inactive_fg]="{{muted}}"

# Text painted on top of graphs (uptime, graph scaling)
theme[graph_text]="{{muted}}"

# Background of the percentage meters
theme[meter_bg]="{{lighter_background}}"

# Misc colors for the processes box, including mini CPU graphs
theme[proc_misc]="{{accent}}"

# Box outline colors
theme[cpu_box]="{{magenta}}"
theme[mem_box]="{{green}}"
theme[net_box]="{{red}}"
theme[proc_box]="{{accent}}"

# Box divider and small-box line color
theme[div_line]="{{muted}}"

# Temperature gradient
theme[temp_start]="{{green}}"
theme[temp_mid]="{{yellow}}"
theme[temp_end]="{{red}}"

# CPU gradient
theme[cpu_start]="{{cyan}}"
theme[cpu_mid]="{{blue}}"
theme[cpu_end]="{{magenta}}"

# Mem/Disk free meter
theme[free_start]="{{magenta}}"
theme[free_mid]="{{blue}}"
theme[free_end]="{{cyan}}"

# Mem/Disk cached meter
theme[cached_start]="{{blue}}"
theme[cached_mid]="{{cyan}}"
theme[cached_end]="{{magenta}}"

# Mem/Disk available meter
theme[available_start]="{{yellow}}"
theme[available_mid]="{{red}}"
theme[available_end]="{{red}}"

# Mem/Disk used meter
theme[used_start]="{{green}}"
theme[used_mid]="{{cyan}}"
theme[used_end]="{{blue}}"

# Download graph
theme[download_start]="{{yellow}}"
theme[download_mid]="{{red}}"
theme[download_end]="{{red}}"

# Upload graph
theme[upload_start]="{{green}}"
theme[upload_mid]="{{cyan}}"
theme[upload_end]="{{blue}}"

# Process gradient for threads, memory, and CPU usage
theme[process_start]="{{cyan}}"
theme[process_mid]="{{blue}}"
theme[process_end]="{{magenta}}"

# Process box states. Pause/follow paint a colored ground, so their text uses
# the black-or-white ink chosen against that ground.
theme[proc_pause_bg]="{{red}}"
theme[proc_follow_bg]="{{blue}}"
theme[proc_banner_bg]="{{accent}}"
theme[proc_banner_fg]="{{on_accent}}"

# Followed process
theme[followed_bg]="{{blue}}"
theme[followed_fg]="{{on_blue}}"
